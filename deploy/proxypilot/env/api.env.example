# -----------------------------------------------------------------------------
# The API container's environment — copy to api.env and fill in.
# S3_ACCESS_KEY / S3_SECRET_KEY are NOT here: bootstrap-garage.sh mints them on
# the first run and writes them to garage.env, which the API also reads.
# -----------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info

# --- HTTP ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
API_URL=https://chat.example.com/api
WEB_URL=https://chat.example.com
CORS_ORIGINS=https://chat.example.com
# Behind ProxyPilot's Caddy, so the client IP comes from X-Forwarded-For.
TRUST_PROXY=true

# --- Data ---------------------------------------------------------------------
DATABASE_URL=postgresql://neon:<POSTGRES_PASSWORD>@postgres:5432/neon?schema=public
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_PREFIX=neon:

# --- Secrets ------------------------------------------------------------------
JWT_SECRET=                 # openssl rand -base64 48   (min 32 chars)
SESSION_SECRET=             # openssl rand -base64 48   (min 32 chars)
ENCRYPTION_KEY=             # openssl rand -hex 32      (exactly 64 hex chars)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=neon.sid

# --- Object storage -----------------------------------------------------------
# S3_ENDPOINT is how the API reaches Garage; S3_PUBLIC_ENDPOINT is what goes
# into pre-signed URLs, so it must be a host the browser can reach AND must not
# have its path rewritten in transit, or SigV4 will not verify.
S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=https://neon-s3.example.com
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_BUCKET_MEDIA=neon-media
S3_BUCKET_BACKUPS=neon-backups
S3_BUCKET_RECORDINGS=neon-recordings
# Origin allowed to talk to the buckets from a browser (used by put-bucket-cors).
NEON_PUBLIC_ORIGIN=https://chat.example.com

# --- MEET (calls and meetings) ------------------------------------------------
# NEON runs no SFU; calls and meetings are MEET rooms framed by the client.
# There is nothing to set here: each organisation points at its MEET (base
# URL + API key) in the dashboard under Admin → Integrations → MEET, and the
# API reads that per request. The base URL must be exactly the origin the
# browser will load, because the embed's postMessage traffic is checked
# against it literally.

# --- Mail ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=NEON
SMTP_FROM_EMAIL=neon@example.com

# --- First-run seed -----------------------------------------------------------
# Used once, by packages/database/prisma/seed.js, to create the first
# organization and its admin. Change the password after the first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

COMPLIANCE_MODE=HIPAA
