# -----------------------------------------------------------------------------
# Compose interpolation values — copy to deploy.env and fill in.
# Read by `docker compose --env-file env/deploy.env`; these are NOT passed to
# the API container (that is api.env).
# -----------------------------------------------------------------------------

# Postgres
POSTGRES_USER=neon
POSTGRES_PASSWORD=          # openssl rand -hex 24
POSTGRES_DB=neon

# Redis
REDIS_PASSWORD=             # openssl rand -hex 24

# Garage — cluster secrets (must be 32 bytes of hex for RPC)
GARAGE_RPC_SECRET=          # openssl rand -hex 32
GARAGE_ADMIN_TOKEN=         # openssl rand -hex 32

# LiveKit — "<api-key>: <api-secret>", the same pair as api.env
LIVEKIT_KEYS=APIxxxxxxxxxxxx: your-livekit-secret

# Public URLs baked into the web bundle and written to /config.js at runtime.
# PUBLIC_LIVEKIT_URL is read at build time by the call pages, so a change here
# needs a rebuild of the web image, not just a restart.
APP_NAME=NEON
PUBLIC_API_URL=https://chat.example.com/api
PUBLIC_WS_URL=wss://chat.example.com
PUBLIC_LIVEKIT_URL=wss://chat.example.com/livekit
